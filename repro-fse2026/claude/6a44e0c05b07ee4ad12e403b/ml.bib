@TECHREPORT{kang1990,
	author = "K. Kang and S. Cohen and J. Hess and W. Novak and S.
Peterson",
	title = "{Feature-Oriented Domain Analysis (FODA)}",
	institution = "SEI",
	year = "1990",
	number = "CMU/SEI-90-TR-21",
	month = nov,
	abstract = "Successful software reuse requires the systematic discovery
and exploitation of commonality across related software systems. By examining
related software systems and the underlying theory of the class of systems they
represent, domain analysis can provide a generic description of the requirements
of that class of systems and a set of approaches for their implementation. This
report will establish methods for performing a domain analysis and describe the
products of the domain analysis process. To illustrate this application of
domain analysis to a representative class of software systems, this report will
provide a domain analysis of window management systems software.",
	available = "1",
	category = "Requirements Engineering",
	method = "FODA"
}

